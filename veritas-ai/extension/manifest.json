{
  "manifest_version": 3,
  "name": "Veritas AI: Truth Intelligence Engine",
  "version": "1.0",
  "description": "Real-time AI logic verification explicitly analyzing news and tweets securely over the Veritas API ecosystem.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*",
    "https://api.veritas.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles/overlay.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Veritas Configuration"
  }
}
